DATABASE_URL="postgresql://user:password@localhost:5432/yy_parfums"
JWT_SECRET="change-me-in-production"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Seeded as the first staff login (npm run seed) - change the password after first login.
ADMIN_EMAIL="admin@yyparfums.com"
ADMIN_PASSWORD="changeme123"

# Optional - if any of these are missing, new-order emails are skipped (logged, not an
# error). SMTP credentials for the mailbox that sends the notification.
SMTP_HOST="mail.yourdomain.com"
SMTP_PORT=465
SMTP_USER="support@yyparfum.com"
SMTP_PASSWORD="change-me"
# Where the new-order notification is sent - can be the same mailbox as SMTP_USER.
NOTIFY_EMAIL="support@yyparfum.com"
