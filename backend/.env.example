DATABASE_URL="postgresql://user:password@localhost:5432/yy_parfums"
JWT_SECRET="change-me-in-production"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Seeded as the first staff login (npm run seed) - change the password after first login.
ADMIN_EMAIL="admin@yyparfums.com"
ADMIN_PASSWORD="changeme123"

# Optional - sends a Telegram message on every new order. Skipped (logged, not an error)
# if unset. Create a bot via @BotFather on Telegram to get TELEGRAM_BOT_TOKEN. Each person
# who should be notified messages that bot once (any text), then fetch their chat ID from
# https://api.telegram.org/bot<token>/getUpdates (see each message's chat.id). Comma-
# separate multiple chat IDs to notify more than one person, e.g. "657209251,7758128102".
TELEGRAM_BOT_TOKEN="change-me"
TELEGRAM_CHAT_ID="change-me"

# Not currently used - Railway blocks outbound SMTP (ports 465/587/2525) on all plans
# below Pro, so backend/src/lib/mailer.ts can't connect from there. Kept for later (a
# Pro plan, or a host that doesn't block SMTP). See backend/README.md.
# SMTP_HOST="mail.yourdomain.com"
# SMTP_PORT=465
# SMTP_USER="support@yyparfum.com"
# SMTP_PASSWORD="change-me"
# NOTIFY_EMAIL="support@yyparfum.com"
