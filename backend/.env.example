# Must point at a MongoDB replica set (required for transactions/nested writes) -
# a free MongoDB Atlas M0 cluster satisfies this automatically.
DATABASE_URL="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/yy_parfums?retryWrites=true&w=majority"
JWT_SECRET="change-me-in-production"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Seeded as the first staff login (npm run seed) - change the password after first login.
ADMIN_EMAIL="admin@yyparfums.com"
ADMIN_PASSWORD="changeme123"
